extends "res://tests/tutorial_test_support.gd"

func _ready() -> void:
	await get_tree().physics_frame
	protect()
	await fixture(2)
	await ticks(15)
	check(session.get_progress()[0]["progress"] == 0, "MOV-01 stationary")
	context.hero.position += Vector2(100, 0)
	await ticks(3)
	check(session.get_progress()[0]["progress"] == 0, "MOV-10 spawn/teleport ignored")
	var camera := Camera2D.new()
	context.world.add_child(camera)
	camera.position += Vector2(100, 30)
	await ticks(3)
	check(session.get_progress()[0]["progress"] == 0, "MOV-12 camera ignored")
	await walk("move_right", 2)
	check(session.get_progress()[0]["progress"] == 0, "MOV-07 sub-threshold displacement")
	for unused in 10:
		await walk("move_right", 1)
		await walk("move_left", 1)
	check(session.get_progress()[0]["progress"] == 0, "MOV-07 oscillation cannot accumulate")
	Input.action_press("move_right")
	context.hero.position += Vector2(150, 0)
	await ticks(1)
	Input.action_release("move_right")
	await ticks(2)
	check(session.get_progress()[0]["progress"] == 0, "MOV-10 teleport with held input rejected")
	var wall: Node = context.world.add_wall(Rect2(context.hero.position + Vector2(6, -40), Vector2(8, 80)))
	await walk("move_right", 25)
	check(session.get_progress()[0]["progress"] == 0, "MOV-06 blocked input is not motion")
	wall.free()
	context.hero.is_hurt = true
	context.hero._hurt_timer = 2.0
	await walk("move_right", 20)
	check(session.get_progress()[0]["progress"] == 0, "MOV-11 hurt/forced motion excluded")
	context.hero.is_hurt = false
	await walk("move_right")
	check(session.get_progress()[0]["progress"] == 1, "MOV-05/08 actual right walk reaches threshold")
	await walk("move_right")
	check(session.get_progress()[0]["progress"] == 1, "MOV-09 same direction counted once")
	await walk("move_up")
	check(session.get_progress()[0]["progress"] == 2, "MOV-02 actual up walk")
	await walk("move_left")
	check(session.get_current_step() == Steps.Step.BASIC_ATTACK, "MOV-04/16 left walk completes movement")
	var old_id: String = session.get_session_id()
	session.restart_tutorial(2)
	await ticks(5)
	check(session.get_session_id() != old_id and session.get_progress()[0]["progress"] == 0, "MOV-13/15 restart rebinds a clean generation")
	await walk("move_down")
	check(session.get_progress()[0]["progress"] == 1, "MOV-03 down walk after restart")
	session.skip_tutorial()
	await ticks(3)
	check(not context.accepting and not is_instance_valid(context.hero), "MOV-14 skip cleans observer/hero")
	await fixture(6)
	context.hero._start_dash(Vector2.RIGHT)
	await walk("move_right", 20)
	check(session.get_progress()[0]["progress"] == 0, "MOV-11 actual frost dash with held walking input excluded")
	await fixture(2)
	var replacement_parent := Node2D.new()
	context.world.add_child(replacement_parent)
	context.hero.reparent(replacement_parent)
	replacement_parent.position += Vector2(100, 0)
	await ticks(3)
	check(session.get_progress()[0]["progress"] == 0 and not context.accepting, "MOV-10 reparenting never grants motion; detached hero tears down arena")
	await fixture(2)
	context.movement.free()
	await walk("move_down")
	check(session.get_progress()[0]["progress"] == 0, "MOV-14 observer deletion revokes movement source")
	finish_suite("[TUTORIAL_MOVEMENT_COMPLETE]")
