static var _cache: Dictionary = {}
static var _tex_cache: Dictionary = {}

## Loads a Doraemon texture at runtime (never preload): scripts keep parsing even on the
## very first project open, before Godot has imported the PNGs. If the import does not
## exist yet, the PNG is read straight from disk so the hero still renders.
static func texture(file: String) -> Texture2D:
	if _tex_cache.has(file):
		return _tex_cache[file]
	var path := DIR + file
	var tex: Texture2D = null
	if ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	if tex == null:
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img != null and not img.is_empty():
			tex = ImageTexture.create_from_image(img)
	if tex != null:
		_tex_cache[file] = tex
	return tex

## Builds SpriteFrames for the given animation names (60 fps base, per-frame tick durations).
static func build(names: Array) -> SpriteFrames:
	var key := ",".join(names)
	if _cache.has(key):
		return _cache[key]
	var frames := SpriteFrames.new()
	if frames.has_animation("default") and not names.has("default"):
		frames.remove_animation("default")
	for anim in names:
		var info: Dictionary = ANIMS[anim]
		var tex: Texture2D = texture(String(info["file"]))
		var cell: Vector2 = info["cell"]
		frames.add_animation(anim)
		frames.set_animation_speed(anim, 60.0)
		frames.set_animation_loop(anim, bool(info["loop"]))
		var ticks: Array = info["ticks"]
		for i in range(ticks.size()):
			var atlas := AtlasTexture.new()
			atlas.atlas = tex
			atlas.region = Rect2(Vector2(cell.x * i, 0), cell)
			frames.add_frame(anim, atlas, float(ticks[i]))
	_cache[key] = frames
	return frames

## Single still frame of an animation as an AtlasTexture.
static func frame(anim: String, index: int = 0) -> Texture2D:
	var info: Dictionary = ANIMS[anim]
	var cell: Vector2 = info["cell"]
	var atlas := AtlasTexture.new()
	atlas.atlas = texture(String(info["file"]))
	atlas.region = Rect2(Vector2(cell.x * index, 0), cell)
	return atlas

## Offset that puts an animation's anchor on the node origin (centered = false), mirrored if flipped.
static func offset(anim: String, flipped: bool = false) -> Vector2:
	var info: Dictionary = ANIMS[anim]
	var cell: Vector2 = info["cell"]
	var anchor: Vector2 = info["anchor"]
	return Vector2(-(cell.x - anchor.x) if flipped else -anchor.x, -anchor.y)

## Seconds an animation lasts (sum of its frame ticks).
static func duration(anim: String) -> float:
	var total := 0
	for t in ANIMS[anim]["ticks"]:
		total += int(t)
	return total / 60.0
